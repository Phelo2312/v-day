    function updateMetadata(path,page){
      const isHome=path==='/';
      const title=isHome?'Green Building Consultants in Egypt | WAHDJ':`${page?.title||'Page not found'} | WAHDJ`;
      const description=isHome
        ?'LEED, EDGE and TARSHEED certification, energy modeling and commissioning in New Cairo. One accredited team, one contract, nine LEED certifications.'
        :(page?.intro||'We could not find that page.');
      const cleanPath=path==='/'?'/':path.replace(/\/$/,'')+'/';
      const url=`${SITE}/en${cleanPath}`;

      document.title=title;
      document.documentElement.lang='en';
      document.documentElement.dir='ltr';

      const set=(sel,attr,value)=>{
        let el=document.head.querySelector(sel);
        if(!el){el=document.createElement('meta');document.head.appendChild(el);}
        el.setAttribute(attr,value);
      };
      set('meta[name="description"]','content',description);
      set('meta[property="og:title"]','content',title);
      set('meta[property="og:description"]','content',description);
      set('meta[property="og:url"]','content',url);
      set('meta[name="twitter:title"]','content',title);
      set('meta[name="twitter:description"]','content',description);

      let canonical=document.head.querySelector('link[rel="canonical"]');
      if(!canonical){canonical=document.createElement('link');canonical.rel='canonical';document.head.appendChild(canonical);}
      canonical.href=url;

      document.querySelectorAll('script[data-route-schema]').forEach(node=>node.remove());
      const schemas=[];
      if(path!=='/'){
        const parts=path.split('/').filter(Boolean);
        schemas.push({
          '@context':'https://schema.org','@type':'BreadcrumbList',
          itemListElement:[
            {'@type':'ListItem',position:1,name:'Home',item:`${SITE}/en/`},
            ...parts.map((part,i)=>({
              '@type':'ListItem',
              position:i+2,
              name:i===parts.length-1?(page?.title||part):part.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()),
              item:`${SITE}/en/${parts.slice(0,i+1).join('/')}/`
            }))
          ]
        });
        schemas.push({'@context':'https://schema.org','@type':'WebPage','@id':`${url}#webpage`,url,name:title,description,isPartOf:{'@id':'https://www.wahdj.com/#website'},inLanguage:'en'});
      }
      if(path.startsWith('/services/')&&page){
        schemas.push({'@context':'https://schema.org','@type':'Service',name:page.title,description:page.intro,provider:{'@id':'https://www.wahdj.com/#organization'},areaServed:['EG','SA'],url});
        if(page.faqs)schemas.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:page.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
      }
      if(path.startsWith('/sectors/')&&page&&page.faqs){
        schemas.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:page.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
      }
      if(path.startsWith('/projects/')&&page){
        if(page.faqs)schemas.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:page.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
      }
      if(path==='/about'){
        schemas.push({'@context':'https://schema.org','@type':'Person','@id':'https://www.wahdj.com/#radwa-maher-amin',name:'Radwa Maher Amin',jobTitle:'Founder',worksFor:{'@id':'https://www.wahdj.com/#organization'}});
      }
      for(const data of schemas){
        const node=document.createElement('script');
        node.type='application/ld+json';
        node.dataset.routeSchema='';
        node.textContent=JSON.stringify(data);
        document.head.append(node);
      }
    }

    function crumbs(path,page){
      const parts=path.split('/').filter(Boolean);
      $('crumbs').innerHTML=link('/','Home')+parts.map((part,i)=>{
        const route='/'+parts.slice(0,i+1).join('/');
        const label=i===parts.length-1?page.title:(part==='services'?'Services':part==='sectors'?'Sectors':'Projects');
        return `<span aria-hidden="true">›</span>${i===parts.length-1?`<span aria-current="page">${esc(label)}</span>`:link(route,label)}`;
      }).join('');
    }

