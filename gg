  <script>
(() => {
  // Internal editorial configuration only. These are not deployed URLs or crawlable route-head tags.
  const routeInformation = {
    "/en/": {metaTitle:"WAHDJ | Green Building Consultants in Egypt: LEED, EDGE",metaDescription:"Green building consultancy in New Cairo. LEED, EDGE and TARSHEED certification, energy modeling and commissioning under one contract.",schemaTypes:["ProfessionalService"]},
    "/en/about": {metaTitle:"About WAHDJ | Green Building Consultancy in New Cairo",schemaTypes:["BreadcrumbList","Person"]},
    "/en/contact": {metaTitle:"Request a Proposal | WAHDJ Green Building Consultants Cairo",schemaTypes:["ProfessionalService","BreadcrumbList","FAQPage"]},
    "/en/projects/bp-headquarters": {metaTitle:"BP HQ Cairo | LEED v4.1 Existing Buildings Gold | WAHDJ",schemaTypes:["BreadcrumbList","WebPage"],facts:{floorArea:"8,777 m²",levels:"seven",certification:"LEED v4.1 Existing Buildings Gold"}}
  };
  const pages = [...document.querySelectorAll(".page")];
  const menu = document.getElementById("mobile-menu");
  const menuToggle = document.getElementById("menu-toggle");
  const whatsapp = document.getElementById("mobile-whatsapp");
  function route() {
    const path = decodeURIComponent(location.hash.slice(1) || "/en/").replace(/\/+$/,"") || "/en/";
    const page = pages.find(item => (item.dataset.route.replace(/\/+$/,"") || "/en/") === path) || document.querySelector('[data-route="/404"]');
    pages.forEach(item => item.classList.toggle("active",item === page));
    document.title = routeInformation[path]?.metaTitle || page.dataset.title;
    const message = `Hello WAHDJ, I would like to talk about a green building certification project. I found you on your website (${page.dataset.pageName}).`;
    whatsapp.href = "https://wa.me/201224334556?text=" + encodeURIComponent(message);
    menu.hidden = true; menu.classList.add("hidden"); menuToggle.setAttribute("aria-expanded","false");
    window.scrollTo(0,0);
  }
  window.addEventListener("hashchange",route); route();
  menuToggle.addEventListener("click",() => {const open=menu.classList.toggle("hidden") === false;menu.hidden=!open;menuToggle.setAttribute("aria-expanded",String(open));});
  document.querySelectorAll("#mobile-menu a").forEach(a=>a.addEventListener("click",()=>{menu.classList.add("hidden");menu.hidden=true;menuToggle.setAttribute("aria-expanded","false");}));

  const cards=[...document.querySelectorAll(".project-card")],count=document.getElementById("project-count");
  document.querySelectorAll(".filter-btn").forEach(button=>button.addEventListener("click",()=>{
    const filter=button.dataset.filter;
    cards.forEach(card=>card.hidden=filter!=="all"&&card.dataset.status!==filter);
    count.textContent=`${cards.filter(card=>!card.hidden).length} projects shown`;
    document.querySelectorAll(".filter-btn").forEach(item=>{const active=item===button;item.setAttribute("aria-pressed",String(active));item.classList.toggle("btn-outline",!active);});
  }));

  const banner=document.getElementById("cookie-banner"),settings=document.getElementById("cookie-settings");
  let choice={analytics:false,embedded:false};
  function saveCookies(next){choice=next;banner.hidden=true;settings.hidden=true;document.getElementById("map-placeholder").setAttribute("aria-label",next.embedded?"Map approved by visitor; verified embed URL still required":"Map unavailable until embedded-content consent and verified embed URL are supplied");}
  document.getElementById("cookie-accept").addEventListener("click",()=>saveCookies({analytics:true,embedded:true}));
  document.getElementById("cookie-reject").addEventListener("click",()=>saveCookies({analytics:false,embedded:false}));
  function openSettings(){document.getElementById("cookie-analytics").checked=choice.analytics;document.getElementById("cookie-embedded").checked=choice.embedded;settings.hidden=false;document.getElementById("cookie-analytics").focus();}
  document.getElementById("cookie-choose").addEventListener("click",openSettings);
  document.getElementById("cookie-settings-link").addEventListener("click",openSettings);
  document.getElementById("cookie-cancel").addEventListener("click",()=>settings.hidden=true);
  document.getElementById("cookie-save").addEventListener("click",()=>saveCookies({analytics:document.getElementById("cookie-analytics").checked,embedded:document.getElementById("cookie-embedded").checked}));

  const form=document.getElementById("proposal-form"),submit=document.getElementById("submit-request"),status=document.getElementById("form-status");
  const ids=["name","company","email","phone","role","project_type","country","city","area_sqm","project_stage","target_certification"];
  let ready=false;
  (async()=>{try{const result=await window.dataSdk.init({onDataChanged(){}});ready=result.isOk;if(!ready)status.textContent="Something went wrong. Please try again or write to proposals@wahdj.com.";}catch(_){status.textContent="Something went wrong. Please try again or write to proposals@wahdj.com.";}})();
  function fieldError(field,message){document.getElementById(field.id+"-error").textContent=message;field.setAttribute("aria-invalid",String(!!message));}
  form.addEventListener("submit",async event=>{
    event.preventDefault();status.textContent="";let first=null;
    ids.forEach(id=>{const field=document.getElementById(id),value=field.value.trim();let message=id!=="phone"&&!value?"Please fill in this field.":"";
      if(id==="email"&&value&&(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)||/(^|\.)(gmail|yahoo|hotmail)\.[a-z.]+$/i.test(value.split("@")[1]||"")))message="Please enter a work email address, for example name@company.com.";
      if(id==="phone"&&value&&!/^\+?[0-9\s()+-]{7,22}$/.test(value))message="Please enter a valid phone number.";
      if(id==="area_sqm"&&value&&!(Number(value)>0))message="Please enter an area greater than zero.";
      fieldError(field,message);if(message&&!first)first=field;
    });
    if(first){first.focus();return;}
    if(!ready){status.textContent="Something went wrong. Please try again or write to proposals@wahdj.com.";return;}
    submit.disabled=true;document.getElementById("submit-idle").hidden=true;document.getElementById("submit-busy").hidden=false;
    const record=Object.fromEntries(ids.map(id=>[id,document.getElementById(id).value.trim()]));
    const message=document.getElementById("message").value.trim();
    // Consent is recorded within the supplied message field; no extra schema fields are created.
    record.message=(message?message+"\n":"")+(document.getElementById("followup").checked?"Follow-up marketing emails: agreed.":"Follow-up marketing emails: declined.");
    record.submitted_at=new Date().toISOString();
    try{const result=await window.dataSdk.create(record);if(result.isOk){form.reset();location.hash="#/en/thank-you";}else status.textContent="Something went wrong. Please try again or write to proposals@wahdj.com.";}catch(_){status.textContent="Something went wrong. Please try again or write to proposals@wahdj.com.";}finally{submit.disabled=false;document.getElementById("submit-idle").hidden=false;document.getElementById("submit-busy").hidden=true;}
  });
})();
</script>
 
