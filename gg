  <style>
    :root{--primary:#179A5B;--ink:#262626;--deep:#2B544C;--light:#EAEEF4;--white:#FFFFFF;--progress:#B7791F;--status:#6B7280}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{width:100%;margin:0;background:var(--white);color:var(--ink);font:400 17px/1.5 "Avenir","Avenir Next","Nunito Sans",Helvetica,Arial,sans-serif}
    [hidden]{display:none!important}
    a{color:var(--deep);text-underline-offset:4px}
    a:hover{color:var(--ink)}
    button,input,select,textarea{font:inherit}
    :is(a,button,input,select,textarea):focus-visible{outline:3px solid var(--deep);outline-offset:3px}
    h1,h2,h3{font-family:"Avenir","Avenir Next","Nunito Sans",Helvetica,Arial,sans-serif;font-weight:700;line-height:1.2}
    h1{font-size:clamp(32px,3.5vw,44px)}
    h2{font-size:clamp(26px,2.5vw,32px)}
    h3{font-size:clamp(19px,1.8vw,22px)}
    p{margin:0 0 1rem}
    .shell{width:100%;max-width:1220px;margin:auto;padding-inline:clamp(20px,4vw,52px)}
    .band{height:5px;background:var(--primary)}
    .site-header{background:var(--white);border-bottom:1px solid var(--light)}
    .navlink{font-size:14px;font-weight:700;text-decoration:none;padding:9px 3px}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:45px;padding:11px 18px;border:1px solid var(--primary);border-radius:2px;background:var(--primary);color:var(--white);font-weight:700;text-decoration:none;cursor:pointer}
    .btn:hover{background:var(--deep);border-color:var(--deep);color:var(--white)}
    .btn.secondary{background:var(--white);color:var(--deep);border-color:var(--deep)}
    .btn.secondary:hover{background:var(--light)}
    .btn:disabled{opacity:.6;cursor:wait}
    .hero{background:#179A5B;color:var(--white);min-height:max(600px,calc(85 * min(var(--vh, 1vh), 1vh)));overflow:hidden}
    .hero h1,.hero p{color:var(--white)}
    .hero .btn{background:var(--white);color:var(--deep);border-color:var(--white)}
    .hero .btn:hover{background:var(--deep);color:var(--white)}
    .hero .btn.secondary{background:transparent;color:var(--white)}
    .hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,600px) 1fr;gap:32px;align-items:center;min-height:max(600px,calc(85 * min(var(--vh, 1vh), 1vh)))}
    .hero-content{position:relative;z-index:1;max-width:600px;padding-block:52px}
    .hero-content .eyebrow{display:flex;align-items:center;gap:10px}
    .hero-content .eyebrow:before{content:"";height:24px;border-left:1px solid var(--white);border-right:1px solid var(--white);width:7px}
    .hero-photo{position:absolute;z-index:0;right:calc(-1 * clamp(20px,4vw,52px));bottom:0;width:45%;height:100%;object-fit:contain;object-position:bottom right}
    .eyebrow{font-size:14px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
    .section{padding-block:48px;border-bottom:1px solid var(--light)}
    .section h2,.section-heading{position:relative;padding-left:19px}
    .section h2:before,.section-heading:before{content:"";position:absolute;left:0;top:3px;bottom:3px;width:7px;border-left:2px solid var(--primary);border-right:2px solid var(--primary)}
    .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .card,.facts,.summary,.placeholder{background:var(--light);padding:22px;border-radius:2px}
    .card h3{margin:0 0 10px}
    .card p:last-child{margin:0}
    .summary{border-left:4px solid var(--primary)}
    .summary-box{position:relative;z-index:2;max-width:820px;margin-top:-28px;margin-bottom:48px;background:#FFFFFF;border:0;border-left:5px solid #179A5B;border-radius:0 6px 6px 0;box-shadow:0 6px 24px rgba(0,0,0,.08);padding:22px 28px;color:#262626;font-family:"Avenir","Avenir Next","Nunito Sans",Helvetica,Arial,sans-serif;font-size:17px;line-height:1.6}
    .summary-box p{margin:0}
    #home-short-box{color:#262626}
    #route-short-box{color:#262626}
    @media(max-width:767px){.summary-box{max-width:none;margin-left:16px;margin-right:16px;margin-top:-20px;margin-bottom:48px;padding:18px 20px;font-size:16px}}
    .facts{border-left:4px solid var(--primary)}
    .facts dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 20px;margin:12px 0 0}
    .facts dt{font-weight:700;display:inline}
    .facts dd{display:inline;margin:0}
    .placeholder{border:1px dashed var(--deep);font-size:14px}
    .muted{font-size:14px}
    .project-card{display:flex;flex-direction:column;gap:12px}
    .project-card h3{text-transform:uppercase}
    .project-card img{width:100%;height:190px;object-fit:cover}
    .meta{font-size:14px}
    .chip{display:inline-block;padding:5px 10px;color:var(--white);font-size:13px;font-weight:700}
    .chip.certified{background:var(--primary)}
    .chip.progress{background:var(--progress)}
    .chip.assessment,.chip.not-completed{background:var(--status)}
    .tags{display:flex;flex-wrap:wrap;gap:7px}
    .tags span{padding:4px 8px;background:var(--white);font-size:13px}
    .field{width:100%;padding:11px;border:1px solid var(--deep);background:var(--white);color:var(--ink)}
    label{display:block;margin-bottom:5px;font-weight:700}
    .faq-list{border-top:1px solid var(--light)}
    .faq{border-bottom:1px solid var(--light)}
    .faq summary{display:flex;justify-content:space-between;align-items:center;gap:14px;width:100%;padding:16px 0;color:var(--ink);font-weight:700;text-align:left;cursor:pointer;list-style:none}
    .faq summary::-webkit-details-marker{display:none}
    .faq summary::after{content:"▸";flex:0 0 auto;transition:transform .15s}
    .faq[open] summary::after{transform:rotate(90deg)}
    .faq-answer{padding:4px 16px 14px}
    .faq-answer p:last-child{margin:0}
    .site-footer{background:var(--deep);color:var(--white)}
    .site-footer a,.site-footer button{color:var(--white)}
    .site-footer a:hover{text-decoration:underline}
    .footer-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:25px}
    .footer-grid nav{display:flex;flex-direction:column;gap:8px;font-size:14px}
    .footer-grid h2{font-size:17px}
    .cookie{position:fixed;bottom:0;left:0;right:0;z-index:60;background:var(--white);border-top:2px solid var(--deep);box-shadow:0 -8px 25px #26262622;padding:15px 0;max-height:70vh;overflow:auto}
    .cookie h2{font-size:20px}
    .whatsapp{display:none;position:fixed;right:15px;bottom:16px;z-index:50;background:var(--deep);color:var(--white);padding:12px 15px;text-decoration:none;font-weight:700}
    .whatsapp:hover{color:var(--white);background:var(--primary)}
    .cookie:not([hidden])~.whatsapp{bottom:190px}
    .skip{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
    .skip:focus{position:static;left:16px;top:16px;display:inline-block;width:auto;height:auto;background:#fff;padding:10px 16px;border:2px solid var(--deep);z-index:200}
    @media(max-width:900px){.footer-grid{grid-template-columns:repeat(3,1fr)}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-grid{grid-template-columns:1fr}.hero-photo{height:240px;width:calc(100% + clamp(20px,4vw,52px));right:calc(-1 * clamp(20px,4vw,52px));top:0;bottom:auto;object-position:top right}.hero-content{padding-block:38px;margin-top:240px}}
    @media(max-width:700px){body{font-size:16px}.desktop-nav{display:none}.desktop-nav.open{display:flex;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:flex-start;background:var(--white);padding:20px;box-shadow:0 12px 20px #26262622;z-index:55}.cards,.footer-grid,.facts dl{grid-template-columns:1fr}.whatsapp{display:block}.cookie:not([hidden])~.whatsapp{bottom:220px}}
    @media(min-width:701px){#menu-toggle{display:none}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  </style>

